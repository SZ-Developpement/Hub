# Copiez ce fichier en « .env » et renseignez les valeurs.
# Sur Vercel, définissez les mêmes variables dans Settings › Environment Variables.

# ── Base de données (Neon) ───────────────────────────────────────────────────
# URL poolée (hôte contenant « -pooler ») : utilisée par l'application.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# URL directe (sans « -pooler ») : utilisée par la CLI Prisma pour les migrations.
# L'intégration Neon de Vercel la fournit sous ce nom.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Authentification (Better Auth) ───────────────────────────────────────────
# Secret de signature des sessions. Générez-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique de l'application (http://localhost:3000 en local).
BETTER_AUTH_URL="http://localhost:3000"

# ── Fichiers (Vercel Blob) ───────────────────────────────────────────────────
# Jeton du store Blob (logos, signature, justificatifs, PDF archivés).
# Créez le store en accès PRIVÉ. En local, laissez vide : les fichiers vont dans ./.storage
# Sur Vercel, connecter le store au projet suffit : il ajoute ce jeton ou BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=""
# À définir à « public » uniquement si votre store Blob a été créé en accès public.
# BLOB_ACCESS="private"

# ── Tâche quotidienne (Vercel Cron) ──────────────────────────────────────────
# Secret envoyé par Vercel à /api/cron/daily. Générez-le avec : openssl rand -hex 32
CRON_SECRET=""

# ── Optionnel ────────────────────────────────────────────────────────────────
# Si défini, la page de première configuration (/setup) exige ce code pour créer le compte.
# SETUP_TOKEN=""

# Compte créé par le jeu de données de démonstration (pnpm db:seed).
# SEED_USER_EMAIL="demo@szdev.fr"
# SEED_USER_PASSWORD=""

# Développement sur un Postgres local plutôt que sur Neon : lancez « pnpm db:proxy »
# et indiquez ici l'adresse du proxy WebSocket.
# NEON_LOCAL_WS_PROXY="localhost:54330/v1"
